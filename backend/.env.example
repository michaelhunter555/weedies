# Copy to `.env` and fill in values. Do not commit `.env`.

NODE_ENV=development
PORT=5001
CLIENT_ORIGIN=http://localhost:3000

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_EXPIRES_SECONDS=2592000

FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
GOOGLE_CLIENT_ID=

ENCRYPTION_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
STRIPE_PUB_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CUSTOMER_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK=

ADMIN_CREATE_EMAIL=

GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
GOOGLE_ANALYTICS_REDIRECT_URI=

OPENAI_API_SECRET_KEY=

BREVO_API_KEY=

# Set to "false" to disable the Mon/Thu seller payout cron in app.ts
ENABLE_PAYOUT_CRON=true

# Set to "false" to disable the daily inactive/closed chat purge cron in app.ts
ENABLE_CHAT_PURGE_CRON=true

# Escrow.com (sandbox defaults in escrow-api.ts)
ESCROW_API_EMAIL=
ESCROW_API_KEY=
# Broker / partner on Escrow transactions (API user should match ESCROW_API_EMAIL)
# ESCROW_BROKER_EMAIL=info@elevatedappgroup.com
# Webhook URL: prod https://dapandflip.com/api/escrow/webhook; dev localhost (see register-escrow-webhook.ts)
# ESCROW_INSPECTION_PERIOD_SECONDS=259200
# Optional: integration helper password (defaults to ESCROW_API_KEY)
# ESCROW_INTEGRATION_PASSWORD=
# ESCROW_API_BASE_URL=https://api.escrow-sandbox.com/2017-09-01
# ESCROW_WEB_ORIGIN=https://www.escrow-sandbox.com
# ESCROW_INTEGRATION_BASE_URL=https://integrationhelper.escrow-sandbox.com/v1
# Set true to allow POST /api/escrow/dev/register-webhook in production
# ENABLE_ESCROW_WEBHOOK_SETUP=false
